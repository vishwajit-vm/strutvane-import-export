{
  "name": "@strutvane/import-export",
  "version": "0.1.0",
  "description": "CSV and Excel (XLSX) import and export for Strutvane models: column mapping, per-row validation, dry runs, resumable chunked imports in transactions, upserts, tenant- and policy-scoped writes, and streaming, formula-safe exports.",
  "keywords": [
    "strutvane",
    "import",
    "export",
    "csv",
    "xlsx",
    "excel",
    "spreadsheet",
    "orm"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-import-export#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-import-export/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-import-export.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./commands": {
      "types": "./dist/commands.d.mts",
      "default": "./dist/commands.mjs"
    },
    "./installer": {
      "types": "./dist/installer.d.mts",
      "default": "./dist/installer.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "strutvane": {
    "commands": "./dist/commands.mjs",
    "installer": "./dist/installer.mjs",
    "compat": "^0.2.0-next.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "peerDependencies": {
    "@strutvane/framework": "^0.2.0-next.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@strutvane/framework": "0.2.0-next.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  }
}
